; ============================================================
; AIRDOM Native — Windows (Godot 4.7 Forward+)
; شبیه‌ساز نبرد هوایی — فیزیک واقعی‌گرا
; ============================================================
config_version=5

[application]

config/name="AIRDOM"
config/description="War Thunder-style air combat sim — real flight physics"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.027, 0.043, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/glow/upscale_mode=1
